// Datový model aplikace pro tvorbu FVE dokumentace.
//
// Zásady:
//  - Projektová data jsou JSONB (project_data), protože struktura se liší
//    podle firmy a bude se vyvíjet. Validuje je JSON Schema, ne databáze.
//  - Katalogy, verze, šablony a dokumenty jsou relační – tam potřebujeme
//    integritu a dotazy.
//  - Každá verze projektu je neměnný snapshot. Původní verze se nikdy
//    nepřepisuje (bod 49 zadání).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- uživatelé

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  projects  Project[]
  companies Company[]
  auditLog  AuditLog[]
}

// ------------------------------------------------------- firmy a zpracovatelé

/// Zpracovatel dokumentace. Na něj jsou navázané firemní konstanty –
/// autorizovaná osoba, zhotovitel, razítko, logo (Q-24, Q-25).
model Company {
  id            String        @id @default(cuid())
  owner         User          @relation(fields: [ownerId], references: [id])
  ownerId       String
  name          String
  ico           String?
  address       String?
  logoKey       String?
  /// Označení rozvaděčů, číselné řady, výchozí hodnoty (Q-31, Q-32, Q-38)
  settings      Json          @default("{}")
  /// Konstanty, které se u této firmy nikdy nemění (Q-25)
  constants     Json          @default("{}")
  templateSets  TemplateSet[]
  projects      Project[]
  boqTemplates  BoqTemplate[]
  createdAt     DateTime      @default(now())

  @@unique([ownerId, name])
}

/// Dokumentační systém: V1 JABLONEC, V2 UNIVERZÁL, V3 SIMPLY.
/// Není to verze téhož dokumentu, ale jiný způsob práce (bod 57).
model TemplateSet {
  id          String     @id @default(cuid())
  company     Company    @relation(fields: [companyId], references: [id])
  companyId   String
  code        String // V1 | V2 | V3 | ...
  name        String
  /// Pořadí a povinnost dokumentů v sadě
  documents   Json       @default("[]")
  templates   Template[]
  projects    Project[]
  createdAt   DateTime   @default(now())

  @@unique([companyId, code])
}

/// Jedna šablona = jeden typ dokumentu. Originální .docx zůstává
/// nedotčený v úložišti; manifest drží anotace z parseru.
model Template {
  id            String       @id @default(cuid())
  set           TemplateSet  @relation(fields: [setId], references: [id])
  setId         String
  docCode       String // A | B | D.1.1.2 | D.2.2 | VYKAZ
  title         String
  /// klíč souboru v S3/R2
  fileKey       String
  fileHash      String
  /// výstup parser.parse_template()
  manifest      Json
  variables     TemplateVariable[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([setId, docCode])
}

/// Kandidát na proměnnou z importu, potvrzený uživatelem.
/// `evidence` nese výsledek křížové analýzy referenčních projektů
/// ("mění se ve 4 z 5 projektů") – bod 62 a 67.
model TemplateVariable {
  id           String   @id @default(cuid())
  template     Template @relation(fields: [templateId], references: [id])
  templateId   String
  key          String
  label        String?
  /// variable | generated | fixed – výsledná role po potvrzení
  role         String
  /// cesta v datovém modelu projektu, např. "pv.count"
  bindPath     String?
  dataType     String   @default("text") // text | number | enum | ref | bool
  unit         String?
  enumValues   Json?
  /// true = firemní konstanta, nezadává se u projektu (Q-25)
  isCompanyConstant Boolean @default(false)
  required     Boolean  @default(false)
  evidence     Json     @default("{}")
  confidence   Float    @default(0)
  occurrences  Json     @default("[]")

  @@unique([templateId, key])
}

/// Pravidlo, kterým uživatel opravil závěr analýzy. Použije se
/// u dalších importů (bod 68).
model LearnedRule {
  id        String   @id @default(cuid())
  scope     String // global | company:<id> | set:<id>
  matcher   Json // podle čeho se pravidlo uplatní
  decision  Json // co se má nastavit
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- projekty

model Project {
  id            String           @id @default(cuid())
  owner         User             @relation(fields: [ownerId], references: [id])
  ownerId       String
  company       Company          @relation(fields: [companyId], references: [id])
  companyId     String
  set           TemplateSet      @relation(fields: [setId], references: [id])
  setId         String
  orderNumber   String
  name          String
  /// rozpracovany | ke_kontrole | schvaleny | realizovany | archivovany
  status        String           @default("rozpracovany")
  /// pracovní (neuzavřená) data projektu
  data          Json             @default("{}")
  /// provenience polí: zdroj, stav, kdo a kdy potvrdil (bod 17, 41, 64)
  provenance    Json             @default("{}")
  currentVersion String?
  versions      ProjectVersion[]
  files         ProjectFile[]
  documents     GeneratedDocument[]
  boq           BoqItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  archivedAt    DateTime?

  @@unique([ownerId, orderNumber])
  @@index([ownerId, status])
}

/// Neměnný snapshot projektu. Nikdy se needituje (bod 15, 49).
model ProjectVersion {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  label       String // 1.0, 1.1, 2.0
  parentId    String?
  data        Json
  provenance  Json
  changelog   Json     @default("[]")
  createdBy   String
  createdAt   DateTime @default(now())
  documents   GeneratedDocument[]

  @@unique([projectId, label])
}

model ProjectFile {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  kind       String // vykres | datasheet | nabidka | foto | jine
  fileName   String
  fileKey    String
  mimeType   String
  sizeBytes  Int
  hash       String
  /// co z něj extraktor vytáhl (kandidáti, ne pravdy)
  extraction Json?
  createdAt  DateTime @default(now())
}

/// Vygenerovaný soubor je vždy vázaný na projekt a verzi (bod 38).
model GeneratedDocument {
  id          String          @id @default(cuid())
  project     Project         @relation(fields: [projectId], references: [id])
  projectId   String
  version     ProjectVersion  @relation(fields: [versionId], references: [id])
  versionId   String
  docCode     String
  revision    String          @default("Rev00")
  fileKey     String
  fileName    String
  /// hash vstupních dat – pozná se, že dokument je zastaralý
  inputsHash  String
  /// true = uživatel soubor ručně upravil ve Wordu (Q-47)
  manuallyEdited Boolean      @default(false)
  unresolved  Json            @default("[]")
  createdAt   DateTime        @default(now())

  @@index([projectId, docCode])
}

// ------------------------------------------------------------ výkaz výměr

model BoqTemplate {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  /// díly, položky, pravidla množství, podmínky zobrazení
  structure Json
  createdAt DateTime @default(now())
}

model BoqItem {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  section     Int
  sectionName String
  position    Int
  name        String
  description String?
  supplier    String?
  unit        String
  /// text, ne číslo – "dle trasy", "netýká se" jsou platné hodnoty
  quantity    String
  /// vzorec, kterým se množství odvodilo (prázdné = zadal uživatel)
  formula     String?
  source      String   @default("user")
  needsReview Boolean  @default(false)

  @@index([projectId, section, position])
}

// --------------------------------------------------- katalog zařízení

model Device {
  id            String   @id @default(cuid())
  category      String // panel | inverter | optimizer | battery | switchboard | cable
  manufacturer  String
  model         String
  /// parametry podle kategorie
  params        Json
  /// kde se parametry vzaly
  sourceUrl     String?
  datasheetKey  String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())

  @@unique([category, manufacturer, model])
  @@index([category])
}

// ---------------------------------------------------------- validace

/// Pravidla pre-flight kontroly jsou data, ne kód – dají se přidávat
/// bez nasazení nové verze (bod 28, 42).
model ValidationRule {
  id          String   @id @default(cuid())
  code        String   @unique // PV-01, EN-01, BOQ-02 ...
  title       String
  severity    String // error | warning | info
  /// výraz nad projektovými daty
  expression  String
  message     String
  scope       String   @default("global") // global | company:<id> | set:<id>
  enabled     Boolean  @default(true)
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
