# Databáze (Neon / lokální Postgres)
DATABASE_URL="postgresql://user:heslo@host/fve?sslmode=require"

# Úložiště souborů (Cloudflare R2 / S3)
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_BUCKET="fve-dokumentace"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Dokumentová služba
DOCX_ENGINE_URL="http://localhost:8100"

# AI (server-side, nikdy ve frontendu)
ANTHROPIC_API_KEY=""

# E-mail – posílá se odkaz ke stažení, ne přílohy
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
DOWNLOAD_LINK_TTL_HOURS="72"

# Přihlášení
AUTH_SECRET=""
